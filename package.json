{
  "name": "dsh-claude-ssh",
  "version": "0.1.4",
  "description": "Claude SSH — 在 DeepSeek Harness 中使用远端 Claude Code",
  "type": "module",
  "main": "lib/server/index.js",
  "types": "lib/server/index.d.ts",
  "exports": { ".": { "types": "./lib/server/index.d.ts", "default": "./lib/server/index.js" }, "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:ui": "node scripts/test-select-ui.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=22.15.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "keywords": ["dsh-plugin", "deepseek-harness", "ssh", "claude-code"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lalaze/dsh-claude-ssh.git" },
  "dsh": {
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace"] },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.5", "@deepseek-ai/dsh-llm": "0.2.1-rc.2", "@deepseek-ai/schemastery": "~3.18.5", "react": "^18.3.1", "react-dom": "^18.3.1" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": {"optional": true}, "@deepseek-ai/dsh-llm": {"optional": true}, "@deepseek-ai/schemastery": {"optional": true}, "react": {"optional": true}, "react-dom": {"optional": true} },
  "devDependencies": {
    "typescript": "^5.9.3", "tsx": "^4.20.6", "esbuild": "^0.25.11", "@types/node": "^22.19.0", "@types/react": "^18.3.26", "@types/react-dom": "^18.3.7", "react": "^18.3.1", "react-dom": "^18.3.1",
    "@deepseek-ai/cordis": "~4.0.5", "@deepseek-ai/schemastery": "~3.18.5", "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2", "@deepseek-ai/dsh-session": "0.2.1-rc.2", "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2", "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2", "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2", "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2"
  }
}
