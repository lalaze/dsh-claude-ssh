{
  "name": "dsh-plugins",
  "private": true,
  "description": "Independent DeepSeek Harness plugins in one workspace",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:ui": "pnpm -r --if-present run test:ui",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "pack:plugins": "pnpm -r --filter './packages/*' pack --pack-destination dist"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalaze/dsh-plugins.git"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "esbuild": "^0.25.11",
    "@types/node": "^22.19.0"
  }
}
