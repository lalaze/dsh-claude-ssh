{
  "name": "dsh-magpie-quota",
  "version": "0.1.0",
  "description": "Compact per-account Magpie quota icons and details for DeepSeek Harness",
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/server/index.js",
  "types": "lib/server/index.d.ts",
  "exports": {
    ".": { "types": "./lib/server/index.d.ts", "default": "./lib/server/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "icon.svg", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "prepack": "pnpm run build",
    "pack:plugin": "pnpm pack --pack-destination ../../dist",
    "test:ui": "node scripts/test-quota-ui.mjs",
    "preview:ui": "node scripts/preview-quota.mjs"
  },
  "engines": { "node": ">=22.19.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "keywords": ["dsh-plugin", "deepseek-harness", "magpie", "quota"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lalaze/dsh-plugins.git", "directory": "packages/magpie-quota" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-settings"] }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-launch-environment": { "optional": true },
    "@deepseek-ai/dsh-llm-pi-ai": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7"
  }
}
