{
  "name": "dsh-claude-ssh",
  "version": "0.3.2",
  "description": "Claude Code for DSH, based on Oh My Claude with verified dsh-remote workspace routing",
  "type": "module",
  "icon": "icon.svg",
  "homepage": "https://github.com/lalaze/dsh-claude-ssh",
  "bugs": { "url": "https://github.com/lalaze/dsh-claude-ssh/issues" },
  "main": "lib/server/adapter.js",
  "types": "lib/server/adapter.d.ts",
  "exports": {
    ".": { "types": "./lib/server/adapter.d.ts", "default": "./lib/server/adapter.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "UPSTREAM.md", "CHANGELOG.md", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "prepack": "pnpm run build",
    "pack:plugin": "pnpm pack --pack-destination ../../dist"
  },
  "engines": { "node": ">=22.15.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "keywords": ["dsh-plugin", "deepseek-harness", "ssh", "claude-code"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lalaze/dsh-claude-ssh.git", "directory": "packages/claude-ssh" },
  "dsh": {
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-model-selection"] },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5", "@deepseek-ai/dsh-llm": "0.2.1-rc.2", "@deepseek-ai/schemastery": "~3.18.5", "react": "^18.3.1", "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true }, "@deepseek-ai/dsh-llm": { "optional": true }, "@deepseek-ai/schemastery": { "optional": true }, "react": { "optional": true }, "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5", "@deepseek-ai/dsh-llm": "0.2.1-rc.2", "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2", "@deepseek-ai/schemastery": "~3.18.5", "@types/react": "^18.3.26", "@types/react-dom": "^18.3.7", "react": "^18.3.1", "react-dom": "^18.3.1"
  }
}
