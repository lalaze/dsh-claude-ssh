{
  "name": "dsh-usage-stats",
  "version": "0.1.1",
  "description": "Local model usage statistics for DeepSeek Harness",
  "type": "module",
  "main": "lib/server/index.js",
  "types": "lib/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/server/index.d.ts",
      "default": "./lib/server/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "prepack": "pnpm run build",
    "pack:plugin": "pnpm pack --pack-destination ../../dist",
    "test:ui": "node scripts/test-dashboard-ui.mjs",
    "preview:ui": "node scripts/preview-dashboard.mjs"
  },
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "usage",
    "tokens"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalaze/dsh-plugins.git",
    "directory": "packages/usage-stats"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7"
  }
}
